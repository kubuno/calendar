<Project Sdk="Kubuno.Rust.Sdk/1.1.1">

  <!-- The native desktop Calendar app for Windows (kubuno-calendar.exe): the Win32 window and its .kbview
       views, opened in the Visual Studio designer. This file is yours: edit it freely. -->
  <PropertyGroup>
    <CargoPackage>kubuno-calendar</CargoPackage>
    <CargoBin>kubuno-calendar</CargoBin>
    <!-- One `cargo build` of the desktop workspace for every project of it (docs/RSPROJ.md, "Cargo workspaces"). -->
    <CargoBuildScope>Workspace</CargoBuildScope>
  </PropertyGroup>

</Project>
