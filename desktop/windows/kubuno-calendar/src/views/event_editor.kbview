<!--
  The event editor (web EventEditor.tsx): a two-column modal like the web (≈1024 wide). A full-width header
  (title, the date/time row, the all-day toggle and the recurrence field), then the left « details » column
  (location, calendar + colour, reminders, description) and the right 320px column (guests + permissions).
  Two columns keep the dialog shorter than the screen (the single column ran off a 175% display). Guests and
  reminders are wired in later sub-increments; the right column and the reminders row are reserved here.
-->
<Panel xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x"
       WindowKind="Dialog" Title="{Binding WindowTitle}" DesignWidth="960" DesignHeight="610" AcceptButton="save" OnLoad="editor_load">

  <!-- Header (full width): title -->
  <TextField x:Name="title_box" Text="{Binding Title, Mode=TwoWay}" Placeholder="{Res ev_title_ph}" X="24" Y="20" Width="912" Height="40"/>

  <!-- Header: date / time -->
  <DatePicker x:Name="start_date_box" Date="{Binding StartDate, Mode=TwoWay}" X="24" Y="74" Width="190" Height="36"/>
  <Dropdown x:Name="start_time_box" SelectedValue="{Binding StartTime, Mode=TwoWay}" ItemsSource="{Binding TimeItems}" Visible="{Binding Timed}" X="222" Y="74" Width="104" Height="36"/>
  <Label Text="–" Role="Caption" ForeColor="TextTertiary" Visible="{Binding Timed}" X="332" Y="82" Width="16" Height="20"/>
  <Dropdown x:Name="end_time_box" SelectedValue="{Binding EndTime, Mode=TwoWay}" ItemsSource="{Binding TimeItems}" Visible="{Binding Timed}" X="352" Y="74" Width="104" Height="36"/>
  <DatePicker x:Name="end_date_box" Date="{Binding EndDate, Mode=TwoWay}" X="462" Y="74" Width="190" Height="36"/>

  <!-- Header: all-day + recurrence (+ scope on a recurring edit) -->
  <CheckBox x:Name="allday_box" Text="{Res ev_allday}" Checked="{Binding AllDay, Mode=TwoWay}" X="24" Y="122" Width="150" Height="24" OnCheckedChanged="allday_changed"/>
  <Dropdown x:Name="recur_box" SelectedValue="{Binding Recurrence, Mode=TwoWay}" ItemsSource="{Binding RecurItems}" X="184" Y="118" Width="288" Height="36" OnSelectedValueChanged="recur_changed"/>
  <Dropdown x:Name="scope_box" SelectedValue="{Binding Scope, Mode=TwoWay}" ItemsSource="{Binding ScopeItems}" Visible="{Binding IsRecurringEdit}" X="484" Y="118" Width="300" Height="36"/>

  <!-- Left column: details -->
  <Label Text="{Res ev_location}" Role="Caption" ForeColor="TextTertiary" X="24" Y="178" Width="300" Height="16"/>
  <TextField x:Name="location_box" Text="{Binding Location, Mode=TwoWay}" Placeholder="{Res ev_location_ph}" X="24" Y="198" Width="512" Height="36"/>

  <!-- Reminders (up to two rows): method + offset + remove, then « Add a reminder ». -->
  <Label Text="{Res ev_reminders}" Role="Caption" ForeColor="TextTertiary" X="24" Y="242" Width="300" Height="16"/>
  <Dropdown x:Name="rem1_type_box" SelectedValue="{Binding Rem1Type, Mode=TwoWay}" ItemsSource="{Binding RemTypeItems}" Visible="{Binding Rem1Vis}" X="24" Y="262" Width="130" Height="36"/>
  <Dropdown x:Name="rem1_min_box" SelectedValue="{Binding Rem1Min, Mode=TwoWay}" ItemsSource="{Binding RemMinItems}" Visible="{Binding Rem1Vis}" X="160" Y="262" Width="300" Height="36"/>
  <Button x:Name="rem1_remove" Text="✕" Variant="Ghost" Visible="{Binding Rem1Vis}" AccessibleName="{Res rem_remove}" X="466" Y="262" Width="36" Height="36" OnClick="remove_rem1"/>
  <Dropdown x:Name="rem2_type_box" SelectedValue="{Binding Rem2Type, Mode=TwoWay}" ItemsSource="{Binding RemTypeItems}" Visible="{Binding Rem2Vis}" X="24" Y="302" Width="130" Height="36"/>
  <Dropdown x:Name="rem2_min_box" SelectedValue="{Binding Rem2Min, Mode=TwoWay}" ItemsSource="{Binding RemMinItems}" Visible="{Binding Rem2Vis}" X="160" Y="302" Width="300" Height="36"/>
  <Button x:Name="rem2_remove" Text="✕" Variant="Ghost" Visible="{Binding Rem2Vis}" AccessibleName="{Res rem_remove}" X="466" Y="302" Width="36" Height="36" OnClick="remove_rem2"/>
  <Button x:Name="rem_add_btn" Text="{Res rem_add}" Variant="Text" Visible="{Binding CanAddRem}" X="20" Y="344" Width="220" Height="24" OnClick="add_reminder"/>

  <Label Text="{Res ev_calendar}" Role="Caption" ForeColor="TextTertiary" X="24" Y="378" Width="300" Height="16"/>
  <Dropdown x:Name="cal_box" SelectedValue="{Binding CalValue, Mode=TwoWay}" ItemsSource="{Binding CalItems}" X="24" Y="398" Width="512" Height="36" OnSelectedValueChanged="cal_changed"/>

  <Label Text="{Res ev_color}" Role="Caption" ForeColor="TextTertiary" X="24" Y="446" Width="300" Height="16"/>
  <ColorSwatches x:Name="colors" X="24" Y="466" Width="512" Height="32"/>

  <Label Text="{Res ev_description}" Role="Caption" ForeColor="TextTertiary" X="24" Y="510" Width="300" Height="16"/>
  <TextArea x:Name="desc_box" Text="{Binding Description, Mode=TwoWay}" MinLines="2" MaxLines="3" X="24" Y="530" Width="512" Height="60"/>

  <!-- Right column (X≈600, 320 wide): guests + permissions — added in the next sub-increment. -->

  <Button x:Name="cancel" ActionBar.Region="Right" Text="{Res ev_cancel}" Variant="Secondary" Width="120" Height="36" OnClick="cancel_click"/>
  <Button x:Name="save" ActionBar.Region="Right" Text="{Res ev_save}" Variant="Primary" Width="140" Height="36" OnClick="save_click"/>
</Panel>
