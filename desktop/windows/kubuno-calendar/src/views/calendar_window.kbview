<!--
  Kubuno Calendar's window, laid out like the web (CalendarApp.tsx / CalendarToolbar.tsx): a tall title bar, a
  navigation toolbar matching the web's shell-header nav (a secondary Today button, circular ghost ‹ › arrows,
  the 22px period title, and the view switcher as a soft dropdown — not a segmented control), and the active
  view in the body. This increment renders the Month grid, the Day/Week time grid and the Schedule (agenda)
  list from the offline sample; the Year view and the server-coupled editing are later increments.
-->
<Panel xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x"
       DesignWidth="1200" DesignHeight="800" Title="{Binding WindowTitle}"
       TitleBarStyle="Tall" ShowWaffle="false" ShowAccount="false"
       OnLoad="calendar_window_load">

  <!-- The navigation toolbar. -->
  <Panel x:Name="toolbar" Dock="Top" Height="56" BackColor="Surface">
    <Panel Dock="Bottom" Height="1" BackColor="Border"/>
    <Button x:Name="btn_today" Text="{Res today}" Variant="Secondary" X="16" Y="12" Width="92" Height="32" OnClick="today_click"/>
    <Button x:Name="btn_prev" Text="‹" Variant="Ghost" AccessibleName="{Res prev}" X="116" Y="12" Width="32" Height="32" OnClick="prev_click"/>
    <Button x:Name="btn_next" Text="›" Variant="Ghost" AccessibleName="{Res next}" X="150" Y="12" Width="32" Height="32" OnClick="next_click"/>
    <Label x:Name="period_label" Text="{Binding PeriodTitle}" Role="Title" ForeColor="TextPrimary" TextAlign="MiddleLeft" X="198" Y="12" Width="360" Height="32"/>

    <!-- Search events (live only): typing filters a ±1-year pool; the results list replaces the view. -->
    <TextField x:Name="search_box" Text="{Binding SearchQuery, Mode=TwoWay}" Placeholder="{Res search_ph}" X="570" Y="12" Width="236" Height="32" Visible="{Binding IsLive}" OnTextChanged="search_changed"/>

    <!-- Create an event (live only); double-clicking a day or an event opens the editor too. -->
    <Button x:Name="btn_new" Text="{Res new_event}" Variant="Secondary" AccessibleName="{Res new_event}" X="820" Y="12" Width="188" Height="32" Anchor="Top, Right" Visible="{Binding IsLive}" OnClick="new_click"/>

    <Dropdown x:Name="view_box" SelectedValue="{Binding ViewValue}" ItemsSource="{Binding ViewItems}" AccessibleName="{Res view_month}" X="1016" Y="12" Width="128" Height="32" Anchor="Top, Right" OnSelectedValueChanged="view_changed"/>
  </Panel>

  <!-- The left sidebar (web CalendarSidebarBody): the mini-month navigator and the « Mes agendas » list. -->
  <Panel x:Name="sidebar" Dock="Left" Width="256" BackColor="Surface">
    <Panel Dock="Right" Width="1" BackColor="Border"/>
    <MiniMonth x:Name="mini" X="4" Y="10" Width="248" Height="232" OnDatePicked="mini_date_picked"/>
    <Panel X="12" Y="250" Width="232" Height="1" BackColor="Border"/>
    <Label Text="{Res my_calendars}" Role="Caption" ForeColor="TextSecondary" X="14" Y="262" Width="150" Height="18"/>
    <DropDownButton x:Name="mgmt_btn" Text="{Res mgmt_menu}" Variant="Ghost" Size="Sm" X="162" Y="256" Width="86" Height="24">
      <MenuItem Text="{Res mgmt_subscribe}" Icon="Rss" OnClick="subscribe_click"/>
      <MenuItem Text="{Res mgmt_import}" Icon="Upload" OnClick="import_click"/>
      <MenuItem Text="{Res mgmt_export}" Icon="Download" OnClick="export_click"/>
    </DropDownButton>
    <CalendarList x:Name="cal_list" X="6" Y="286" Width="244" Height="72" OnVisibilityChanged="cal_visibility_changed"/>

    <!-- Weather, Moon and Booking sections (web CalendarSidebarBody). -->
    <Panel X="12" Y="370" Width="232" Height="1" BackColor="Border"/>
    <Label Text="{Res sb_weather}" Role="Caption" ForeColor="TextSecondary" X="14" Y="382" Width="220" Height="18"/>
    <Label Text="{Res sb_weather_add}" Role="Caption" ForeColor="Primary" X="14" Y="406" Width="220" Height="18"/>

    <Panel X="12" Y="438" Width="232" Height="1" BackColor="Border"/>
    <Label Text="{Res sb_moon}" Role="Caption" ForeColor="TextSecondary" X="14" Y="450" Width="220" Height="18"/>
    <MoonWidget x:Name="moon" X="12" Y="474" Width="232" Height="28"/>

    <Panel X="12" Y="514" Width="232" Height="1" BackColor="Border"/>
    <Label Text="{Res sb_booking}" Role="Caption" ForeColor="TextSecondary" X="14" Y="526" Width="220" Height="18"/>
    <Label Text="{Res sb_booking_none}" Role="Caption" ForeColor="TextTertiary" X="14" Y="550" Width="220" Height="18"/>
  </Panel>

  <!-- The body: the active view. -->
  <MonthGrid x:Name="month" AccessibleName="{Res view_month}" Dock="Fill" Visible="{Binding IsMonth}" OnActivated="event_activated"/>
  <TimeGrid x:Name="time_grid" AccessibleName="{Res view_week}" Dock="Fill" Visible="{Binding IsTimeGrid}"/>
  <AgendaList x:Name="agenda" AccessibleName="{Res view_agenda}" Dock="Fill" Visible="{Binding IsAgenda}"/>
  <YearGrid x:Name="year" AccessibleName="{Res view_year}" Dock="Fill" Visible="{Binding IsYear}" OnYearNav="year_nav"/>
  <SearchResults x:Name="search_view" AccessibleName="{Res search_ph}" Dock="Fill" Visible="{Binding IsSearch}" OnResultPicked="search_picked"/>
</Panel>
