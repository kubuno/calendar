<!--
  Add a weather location (web WeatherSettings.tsx): search the geocoder for a city, pick a result and save it.
-->
<Panel xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x"
       WindowKind="Dialog" Title="{Res weather_add_title}" DesignWidth="460" DesignHeight="230" AcceptButton="search">
  <TextField x:Name="query_box" Text="{Binding Query, Mode=TwoWay}" Placeholder="{Res weather_search_ph}" X="24" Y="24" Width="300" Height="36"/>
  <Button x:Name="search" Text="{Res weather_search}" Variant="Secondary" X="332" Y="24" Width="104" Height="36" OnClick="search_click"/>

  <Label Text="{Res weather_pick}" Role="Caption" ForeColor="TextTertiary" X="24" Y="74" Width="412" Height="16"/>
  <Dropdown x:Name="result_box" SelectedValue="{Binding ResultValue, Mode=TwoWay}" ItemsSource="{Binding ResultItems}" X="24" Y="94" Width="412" Height="36"/>

  <Label Text="{Binding Status}" Role="Caption" ForeColor="Danger" X="24" Y="138" Width="412" Height="18"/>

  <Button x:Name="cancel" ActionBar.Region="Right" Text="{Res ev_cancel}" Variant="Secondary" Width="120" Height="36" OnClick="cancel_click"/>
  <Button x:Name="add" ActionBar.Region="Right" Text="{Res share_add}" Variant="Primary" Width="120" Height="36" OnClick="add_click"/>
</Panel>
